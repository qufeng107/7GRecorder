{
  "name": "7grecorder-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -b && vite build",
    "dev:mock": "vite --mode mock --host 127.0.0.1",
    "preview:test": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test:e2e": "playwright test",
    "contracts": "cd ../backend && go run ./cmd/frontend-contracts > ../frontend/src/shared/api/contracts.generated.ts",
    "test:integration": "playwright test --config playwright.integration.config.ts",
    "dev:integration": "python3 ../scripts/dev/local_environment.py",
    "dev:preview": "python3 ../scripts/dev/local_environment.py --mode preview"
  },
  "dependencies": {
    "@tanstack/react-query": "5.87.4",
    "@tanstack/react-table": "8.21.3",
    "@vitejs/plugin-react": "5.0.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.542.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-router-dom": "7.8.2",
    "tailwind-merge": "3.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.34.0",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.3.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "autoprefixer": "10.4.21",
    "eslint": "9.34.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "globals": "16.3.0",
    "jsdom": "26.1.0",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.17",
    "typescript": "5.9.2",
    "typescript-eslint": "8.41.0",
    "vite": "7.1.3",
    "vitest": "3.2.4",
    "@playwright/test": "1.55.0"
  },
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": "22.18.0"
  }
}
