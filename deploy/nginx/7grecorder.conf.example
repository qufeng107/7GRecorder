server {
    listen 80 default_server;
    server_name _;
    return 444;
}

server {
    listen 80;
    server_name 7g.chat www.7g.chat;
    return 301 https://7g.chat$request_uri;
}

server {
    listen 443 ssl http2 default_server;
    server_name _;
    ssl_certificate /etc/nginx/ssl/7g.chat/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/7g.chat/privkey.pem;
    return 444;
}

server {
    listen 443 ssl http2;
    server_name 7g.chat www.7g.chat;

    ssl_certificate /etc/nginx/ssl/7g.chat/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/7g.chat/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000" always;

    root /opt/7grecorder/current/frontend/dist;
    index index.html;

    location /api/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /health/ {
        proxy_pass http://127.0.0.1:8080;
    }

    location /internal/ {
        return 404;
    }

    location /_protected_media/ {
        internal;
        alias /data/7grecorder/;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
